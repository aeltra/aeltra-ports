<?xml version="1.0" encoding="utf-8"?>
<package name="setarch" section="utils">
    <description>
        <summary>setarch tool from util-linux</summary>
        <p>
        This is one program of util-linux in a package of its own, as in
        Alpine, so that it can be installed without the rest and takes the
        place of the applet of busybox.
        </p>
    </description>

    <contents>
        <file src="${prefix}/bin/setarch"/>
        <file src="${prefix}/bin/linux32"/>
        <file src="${prefix}/bin/linux64"/>
        <file src="${prefix}/bin/uname26"/>
        <file src="${prefix}/bin/i386"
            if="(target-build and x86_64) or (tools-build and tools-x86_64)"/>
        <file src="${prefix}/bin/x86_64"
            if="(target-build and x86_64) or (tools-build and tools-x86_64)"/>
        <file src="${prefix}/bin/ppc"
            if="(target-build and powerpc64le) or (tools-build and tools-powerpc64le)"/>
        <file src="${prefix}/bin/ppc32"
            if="(target-build and powerpc64le) or (tools-build and tools-powerpc64le)"/>
        <file src="${prefix}/bin/ppc64"
            if="(target-build and powerpc64le) or (tools-build and tools-powerpc64le)"/>
        <file src="${prefix}/bin/s390"
            if="(target-build and s390x) or (tools-build and tools-s390x)"/>
        <file src="${prefix}/bin/s390x"
            if="(target-build and s390x) or (tools-build and tools-s390x)"/>
    </contents>
</package>
