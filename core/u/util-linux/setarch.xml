<?xml version="1.0" encoding="utf-8"?>
<package name="setarch" section="utils">
    <description>
        <summary>setarch tool from util-linux</summary>
        <p>
        This is one program of util-linux in a package of its own, as in
        Alpine, so that it can be installed without the rest and takes the
        place of the applet of busybox.
        </p>
    </description>

    <contents>
        <file src="${prefix}/bin/setarch"/>
        <file src="${prefix}/bin/linux32"/>
        <file src="${prefix}/bin/linux64"/>
        <file src="${prefix}/bin/uname26"/>
        <file src="${prefix}/bin/i386" if="x86_64"/>
        <file src="${prefix}/bin/x86_64" if="x86_64"/>
        <file src="${prefix}/bin/s390" if="s390x"/>
        <file src="${prefix}/bin/s390x" if="s390x"/>
    </contents>
</package>
