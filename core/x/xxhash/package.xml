<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="xxhash" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Extremely fast hash algorithm</summary>
            <p>
            xxHash is an Extremely fast Hash algorithm, running at RAM speed limits.
            It successfully completes the SMHasher test suite which evaluates collision,
            dispersion and randomness qualities of hash functions. Code is highly portable,
            and hashes are identical on all platforms (little / big endian).
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file 
                subdir="sources"
                src="xxhash-0.8.3.tar.gz"
                upstream-src="http://ftp.debian.org/debian/pool/main/x/xxhash/xxhash_0.8.3.orig.tar.gz"
                sha256sum="aae608dfe8213dfd05d909a57718ef82f30722c392344583d3f39050c7f29a80"
            />
            <file 
                subdir="patches"
                src="debian-patches-2.tar.gz"
                upstream-src=""
                sha256sum="8a11f84a408b43e21bb2196aa00c2645d9d990a1f6d50d0ddabe9a3a92748c3f"
            />
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/reproducible-build.patch"/>
            </patchset>
        </patches>

        <requires>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="xxhash.xml"/>
    <xi:include href="libxxhash0.xml"/>
    <xi:include href="libxxhash-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
