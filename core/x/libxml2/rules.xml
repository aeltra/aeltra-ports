<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
bh_autotools_dev_update
autoreconf -vfi

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --disable-silent-rules \
    --enable-static \
    --with-history \
    --with-legacy \
    --with-http \
    --with-python=no

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

find "$AELTRA_INSTALL_DIR" -name '*.la' -delete

# Not shipped by Debian either.
rm -rf "$AELTRA_INSTALL_DIR/$AELTRA_INSTALL_PREFIX/lib/cmake"

    ]]>
    </install>
</rules>
