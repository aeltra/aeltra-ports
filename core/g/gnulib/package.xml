<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="gnulib" repo="core" architecture-independent="true" if="tools-build or target-build">
        <description>
            <summary>GNU Portability Library</summary>
            <p>
            The GNU portability library is a macro system and C declarations and
            definitions for commonly-used API elements and abstracted system behaviors. It
            can be used to improve portability and other functionality in your programs.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="gnulib-20260704.tar.xz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/g/gnulib/gnulib_20260704.orig.tar.xz"
                sha256sum="51412b01a62e7c68b0c70913d70c50296cfd2f839107020e1d6177ddcf59a84c"/>
            <file src="debian-patches-3.tar.gz" subdir="patches"
                sha256sum="026af66797602e2e47f13e4eddab42a0a848076961d248361b0fa92ed1cad537"/>
            <!-- Ours: gnulib-patch, see rules.xml. -->
            <file src="gnulib-local-1.tar.gz" subdir="extra"
                sha256sum="236806bc5a94051c1dc1e5046cac3e8189489a3680fb7626f49e0dff83b31346"/>
        </sources>

        <!-- Debian's patch is not applied. It makes gnulib-tool ask dpkg
