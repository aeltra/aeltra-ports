<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="libgcrypt20" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>LGPL Crypto library</summary>
            <p>
            libgcrypt contains cryptographic functions. Many important free
            ciphers, hash algorithms and public key signing algorithms have been
            implemented:
            </p>
            <p>
            Arcfour, Blowfish, CAST5, DES, AES, Twofish, Serpent, rfc2268 (rc2), SEED,
            Poly1305, Camellia, ChaCha20, IDEA, Salsa, Blake-2, CRC, MD2, MD4, MD5,
            RIPE-MD160, SHA-1, SHA-256, SHA-512, SHA3-224, SHA3-256, SHA3-384, SHA3-512,
            SHAKE128, SHAKE256, Tiger, Whirlpool, DSA, DSA2, ElGamal, RSA, ECC
            (Curve25519, sec256k1, GOST R 34.10-2001 and GOST R 34.10-2012, etc.)
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="libgcrypt20-1.12.4.tar.bz2" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/libg/libgcrypt20/libgcrypt20_1.12.4.orig.tar.bz2"
                sha256sum="d77f68f48879510e79a2f65977ccc68981781ea0923e5bdffac2a193ea3d660e"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="21198191c05f702032ee4b134763432cd6566c633ba7d032214fdd797ef6ad94"/>
        </sources>

        <!-- Debian's patches are not applied. The first two change what
             libgcrypt-config prints, for Debian's multiarch folders and
             its dependencies, the third one is for its own packaging and
             needs configure to be made again. See the comment in
             rules.xml. -->
        <!--
        <patches>
            <patchset subdir="sources">
                <file src="patches/12_lessdeps_libgcrypt-config.diff"/>
                <file src="patches/15_multiarchpath_in_-L.diff"/>
                <file src="patches/25_norevisionfromgit.diff"/>
            </patchset>
        </patches>
        -->

        <requires>
            <package name="libgpg-error-dev" version=">= 1.56"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libgcrypt20-dev.xml"/>
    <xi:include href="libgcrypt20.xml"/>
    <xi:include href="libgcrypt-bin.xml"/>

    <xi:include href="changelog.xml"/>
</control>
