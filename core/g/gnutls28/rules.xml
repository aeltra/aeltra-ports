<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --enable-ld-version-script \
    --enable-cxx \
    --enable-static \
    --without-lzo \
    --enable-libdane \
    --without-tpm \
    --disable-guile \
    --disable-heartbeat-support \
    --enable-openssl-compatibility \
    --with-included-unistring \
    --disable-silent-rules \
    --with-unbound-root-key-file="$AELTRA_INSTALL_PREFIX/share/dns/root.key" \
    --with-default-trust-store-file=/etc/ssl/certs/ca-certificates.crt \
    --with-autoopts-config="$AELTRA_INSTALL_PREFIX/bin/autoopts-config" \
    --with-packager=Bolt \
    --disable-gtk-doc \
    --disable-doc

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
