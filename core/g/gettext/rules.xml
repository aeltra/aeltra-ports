<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
bh_autotools_dev_update

cd "$AELTRA_BUILD_DIR"
$AELTRA_SOURCE_DIR/configure \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --enable-threads \
    --enable-openmp \
    --disable-native-java \
    --disable-rpath \
    --disable-nls \
    --disable-silent-rules \
    --without-emacs

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS" USEJAVA=0

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
