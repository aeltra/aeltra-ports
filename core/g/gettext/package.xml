<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="gettext" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>GNU Internationalization tools and library</summary>
            <p>
            A programming library and a set of tools for creating multi-lingual software
            programs.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="gettext-1.0.tar.xz" subdir="sources"
                sha256sum="71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7"/>
            <file src="debian-patches-5.tar.gz" subdir="patches"
                sha256sum="3f59e09b193f34dde988719f0046e79dcbf980de6a78b28df312e4caec63a1f9"/>
        </sources>

        <patches>
