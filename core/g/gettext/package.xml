            </patchset>
        </patches>

        <requires>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="bison"/>
            <package name="file"/>
            <package name="libacl1-dev"/>
            <package name="libattr1-dev"/>
            <package name="libncurses-dev"/>
            <package name="libunistring-dev"/>
            <package name="libxml2-dev"/>
            <package name="xz-utils"/>
