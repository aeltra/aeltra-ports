<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --with-gpg-error-prefix="$AELTRA_INSTALL_PREFIX" \
    --with-libgcrypt-prefix="$AELTRA_INSTALL_PREFIX" \
    --with-libassuan-prefix="$AELTRA_INSTALL_PREFIX" \
    --with-ksba-prefix="$AELTRA_INSTALL_PREFIX" \
    --with-npth-prefix="$AELTRA_INSTALL_PREFIX" \
    --disable-doc \
    --disable-rpath \
    --enable-shared \
    --enable-static

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
