<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="gdbm" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>GNU dbm database</summary>
            <p>
            GNU dbm ('gdbm') is a library of database functions that use extendible
            hashing and works similarly to the standard UNIX 'dbm' functions.
            </p>
            <p>
            The basic use of 'gdbm' is to store key/data pairs in a data file, thus
            providing a persistent version of the 'dictionary' Abstract Data Type
            ('hash' to perl programmers).
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="gdbm-1.26.tar.gz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/g/gdbm/gdbm_1.26.orig.tar.gz"
                sha256sum="6a24504a14de4a744103dcb936be976df6fbe88ccff26065e54c1c47946f4a5e"/>
        </sources>

        <requires>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="autopoint"/>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="bison"/>
            <package name="flex"/>
            <package name="libreadline-dev"/>
            <package name="libtool"/>
            <package name="texinfo"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="gdbmtool.xml"/>
    <xi:include href="libgdbm6.xml"/>
    <xi:include href="libgdbm-dev.xml"/>
    <xi:include href="libgdbm-compat4.xml"/>
    <xi:include href="libgdbm-compat-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
