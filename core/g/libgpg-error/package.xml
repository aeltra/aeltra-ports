<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="libgpg-error" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>GnuPG development runtime library</summary>
            <p>
            Library that defines common error values, messages, and common
            runtime functionality for all GnuPG components. Among these are GPG,
            GPGSM, GPGME, GPG-Agent, libgcrypt, pinentry, SmartCard Daemon and
            possibly more in the future.
            </p>
            <p>
            It will likely be renamed "gpgrt" in the future.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="libgpg-error-1.61.tar.bz2" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/libg/libgpg-error/libgpg-error_1.61.orig.tar.bz2"
                sha256sum="7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93"/>
            <file src="debian-patches-5.tar.gz" subdir="patches"
                sha256sum="758be9818d9527aadaed6fa706cb75c2fb646ac707dd0c0d8eabcf9e3db1f201"/>
        </sources>

        <!-- Debian's patches are not applied. The first one is for its own
             packaging and needs configure to be made again, the second
             one is for cross builds, the others are for the tests, which
             are not built. See the comment in rules.xml. -->
        <!--
        <patches>
            <patchset subdir="sources">
                <file src="patches/0001-Remove-upstream-git-fanciness.patch"/>
                <file src="patches/0002-build-No-use-of-awk-with-gen-lock-obj.sh.patch"/>
                <file src="patches/0003-tests-Skip-a-test-when-HAVE_LONG_DOUBLE_WIDER.patch"/>
                <file src="patches/0004-tests-Fix-gpgrt_bsprintf-test-for-PowerPC-64.patch"/>
                <file src="patches/0005-tests-Fix-gpgrt_bsprintf-test-for-PowerPC-32.patch"/>
            </patchset>
        </patches>
        -->

        <requires>
            <package name="gettext" version=">= 0.19.3"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libgpg-error-dev.xml"/>
    <xi:include href="libgpg-error0.xml"/>
    <xi:include href="gpgrt-tools.xml"/>

    <xi:include href="changelog.xml"/>
</control>
