<?xml version="1.0" encoding="utf-8"?>
<package name="gdb" section="devel">
    <description>
        <summary>GNU Debugger</summary>
        <p>
        GDB is a source-level debugger, capable of breaking programs at
        any specific line, displaying variable values, and determining
        where errors occurred.
        </p>
    </description>

    <requires>
        <package name="gdb-common" version="==" cross-tools-prefix="tools-"/>
    </requires>

    <contents subdir="gdb">
        <file src="${prefix}"/>
        <file src="/etc/gdb/gdbinit" conffile="true" if="target-build"/>
        <dir src="/etc/gdb/gdbinit.d" if="target-build"/>
    </contents>
</package>
