<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="gdb" repo="core" architecture-independent="false"
            if="tools-build or target-build or cross-tools-build">
        <description>
            <summary>GNU Debugger</summary>
            <p>
            GDB is a source-level debugger, capable of breaking programs at
            any specific line, displaying variable values, and determining
            where errors occurred. Currently, gdb supports C, C++, D,
            Objective-C, Fortran, Java, OpenCL C, Pascal, assembly, Modula-2,
            Go, and Ada. A must-have for any serious programmer.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="gdb-18.1.tar.xz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/g/gdb/gdb_18.1.orig.tar.xz"
                sha256sum="ddd5627310aedbea90956a6a8774a6558eff2829750376c62b2742ffbac4e61c"/>
            <file src="debian-patches-3.tar.gz" subdir="patches"
                sha256sum="b9fde28a6ca0b60ac6a36acdfb83e8d7c6cd0c6d72ebc6e7e0dc0d83bd616a49"/>
            <file src="alpine-patches-c042f67d.tar.gz" subdir="patches"
                sha256sum="6f8c21aea0ae8a93616250c6b9a12730edc27054816a4d83177c9fdfe5ad6618"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <!-- Debian -->
                <file src="patches/load-versioned-libcc1.patch"/>
                <file src="patches/fix-blhc-libiberty.patch"/>
                <file src="patches/fix-blhc-chew.patch"/>
                <file src="patches/gfdl-dont-build-manpages.patch"/>
                <file src="patches/cross.patch"/>
                <file src="patches/0001-gdb-use-NT_386_TLS-regset-to-access-TLS-GDT-entries-.patch"/>
                <!-- Alpine -->
                <file src="patches/s390x-use-elf-gdb_fpregset_t.patch" if="musl"/>
                <file src="patches/ppc-musl.patch" if="musl"/>
                <file src="patches/ppc-ptregs.patch" if="musl"/>
                <file src="patches/musl-signals.patch" if="musl"/>
            </patchset>
        </patches>

        <requires>
            <package name="bison"/>
            <package name="flex"/>
            <package name="gettext"/>
            <package name="libexpat1-dev"/>
            <package name="libgmp-dev"/>
            <package name="liblzma-dev"/>
            <package name="libmpfr-dev"/>
            <package name="libncurses-dev"/>
            <package name="libreadline-dev"/>
            <package name="libxxhash-dev"/>
            <package name="libzstd-dev"/>
            <package name="pkg-config"/>
            <package name="python3-dev"/>
            <package name="texinfo"/>
            <package name="zlib1g-dev"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="gdb.xml"/>
    <xi:include href="gdb-common.xml"/>
    <xi:include href="gdbserver.xml"/>

    <xi:include href="changelog.xml"/>
</control>
