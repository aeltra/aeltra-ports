<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="gcc-16" repo="core" architecture-independent="false"
            if="tools-build or target-build or cross-tools-build">
        <description>
            <summary>GCC, the GNU Compiler Collection (base package)</summary>
            <p>
            This package contains files common to all languages and libraries
            contained in the GNU Compiler Collection (GCC).
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <!-- MAINTAINER NOTES:
          -
          - Debian keep several tarballs inside the orig tarball. Extract the
          - orig tarball and retrieve the ones you need.
          -
          - To get the patches, the "patch" target has to be executed (see
          - the "run-rules" option of deb2aeltra). Then
          -
          -     sed -i 's/^\(\+\+\+\|\-\-\-\) \([^/ ]\+\)\/src\//\1 \2\//'
          -
          - to fix the path offset. The order of the patches is the order in
          - which the "patch" target applies them.
          -
          - Disable the Ada patches and those to the Ada, D, Modula-2 and
          - Algol 68 manuals, as well as
          -
          - * gcc-distro-specs.diff
          - * g++-multiarch-incdir.diff
          - * gcc-verbose-lto-link.diff (links through /usr/bin/time).
          -
          - Debian's musl-ssp.diff makes GCC link libssp_nonshared on musl,
          - which the musl package provides.
         -->

        <sources>
            <file src="gcc-16.2.0-dfsg.tar.xz" subdir="sources"
                sha256sum="80245fff7d113901c5074f4c1940cfee2c0c6413e3bedab64ed038bde7d33672"/>
            <file src="debian-patches-4.tar.gz" subdir="patches"
                sha256sum="5d8b55fb006d335290926f873d17dc9f60a6e807b8a05b5aa09519765d8da7fb"/>
            <file src="musl-patches-2.tar.gz" subdir="patches"
