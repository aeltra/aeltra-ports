<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="lz4" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Fast LZ compression algorithm library</summary>
            <p>
            LZ4 is a very fast lossless compression algorithm, providing compression speed
            at 400 MB/s per core, scalable with multi-cores CPU. It also features an
            extremely fast decoder, with speed in multiple GB/s per core, typically
            reaching RAM speed limits on multi-core systems.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file 
                subdir="sources"
                src="lz4-1.10.0.tar.gz"
                upstream-src="http://ftp.debian.org/debian/pool/main/l/lz4/lz4_1.10.0.orig.tar.gz"
                sha256sum="537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b"
            />
            <file 
                subdir="patches"
                src="debian-patches-10.tar.gz"
                upstream-src=""
                sha256sum="322ad6db9e23c8bdc6d6b3c1e8fcf679ecf30b3fbb57cd666c242aaf6a15d2a7"
            />
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/use-system-xxhash.patch"/>
                <file src="patches/Create-softlink-for-lz4c.patch"/>
                <file src="patches/Add-license-information-to-pkgconfig.patch"/>
                <file src="patches/CVE-2025-62813.patch"/>
                <file src="patches/tests-test-lz4-abi.py-Drop-m32-and-m64-option-for-te.patch"/>
                <file src="patches/tests-test-lz4-versions.py-Drop-the-building-of-32-b.patch"/>
                <file src="patches/fix-test-lz4-list.py.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="cmake"/>
            <package name="libxxhash-dev"/>
            <package name="pkgconf"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="liblz4-dev.xml"/>
    <xi:include href="liblz4-1.xml"/>
    <xi:include href="lz4.xml"/>

    <xi:include href="changelog.xml"/>
</control>
