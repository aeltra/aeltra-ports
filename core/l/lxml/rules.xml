<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
mkdir -p .mybin
ln -sf "$AELTRA_INSTALL_PREFIX/bin/xml2-config" .mybin/xml2-config
ln -sf "$AELTRA_INSTALL_PREFIX/bin/xslt-config" .mybin/xslt-config

    ]]>
    </prepare>

    <build>
    <![CDATA[

export PATH="$AELTRA_BUILD_DIR/.mybin:$PATH"
cd "$AELTRA_SOURCE_DIR"

bh_python_install --py3 --build \
    -- \
    --with-xslt-config="$AELTRA_INSTALL_PREFIX/bin/xslt-config" \
    --with-xml2-config="$AELTRA_INSTALL_PREFIX/bin/xml2-config"

    ]]>
    </build>

    <install>
    <![CDATA[

export PATH="$AELTRA_BUILD_DIR/.mybin:$PATH"
cd "$AELTRA_SOURCE_DIR"

install -d -m 0755 "$AELTRA_INSTALL_DIR/python3"

bh_python_install --py3 --install \
    --root "$AELTRA_INSTALL_DIR/python3" \
    -- \
    --with-xslt-config="$AELTRA_INSTALL_PREFIX/bin/xslt-config" \
    --with-xml2-config="$AELTRA_INSTALL_PREFIX/bin/xml2-config"

    ]]>
    </install>
</rules>
