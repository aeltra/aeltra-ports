<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="libyaml" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Fast YAML 1.1 parser and emitter library</summary>
            <p>
            LibYAML is a C library for parsing and emitting data in YAML 1.1, a
            human-readable data serialization format.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="libyaml-0.2.5.tar.gz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/liby/libyaml/libyaml_0.2.5.orig.tar.gz"
                sha256sum="fa240dbf262be053f3898006d502d514936c818e422afdcf33921c63bed9bf2e"/>
        </sources>

        <requires>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="libtool"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libyaml-0-2.xml"/>
    <xi:include href="libyaml-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
