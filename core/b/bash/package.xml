<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="bash" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>GNU Bourne Again SHell</summary>
            <p>
            Bash is an sh-compatible command language interpreter that executes
            commands read from the standard input or from a file. Bash also
            incorporates useful features from the Korn and C shells (ksh and csh).
            </p>
            <p>
            Bash is ultimately intended to be a conformant implementation of the
            IEEE POSIX Shell and Tools specification (IEEE Working Group 1003.2).
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="bash-5.3.tar.xz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/b/bash/bash_5.3.orig.tar.xz"
                sha256sum="a70de6bb41f5e192534a5a1836b1d7fad9a8d4818a6e1506d70f38441552c17a"/>
            <file src="debian-patches-4.tar.gz" subdir="patches"
                sha256sum="ccdec1063e39bd55783ee1dc218a93d53162c0b878ebc9b58146c985b3be5e60"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/bash53-001.diff"/>
                <file src="patches/bash53-002.diff"/>
                <file src="patches/bash53-003.diff"/>
                <file src="patches/bash53-004.diff"/>
                <file src="patches/bash53-005.diff"/>
                <file src="patches/bash53-006.diff"/>
                <file src="patches/bash53-007.diff"/>
                <file src="patches/bash53-008.diff"/>
                <file src="patches/bash53-009.diff"/>
                <file src="patches/bash53-010.diff"/>
                <file src="patches/bash53-011.diff"/>
                <file src="patches/bash53-012.diff"/>
                <file src="patches/bash53-013.diff"/>
                <file src="patches/bash53-014.diff"/>
                <file src="patches/bash53-015.diff"/>
                <file src="patches/bashbug-editor.diff"/>
                <file src="patches/deb-bash-config.diff"/>
                <file src="patches/deb-examples.diff"/>
                <file src="patches/man-arithmetic.diff"/>
                <file src="patches/man-fignore.diff"/>
                <file src="patches/man-bashrc.diff"/>
