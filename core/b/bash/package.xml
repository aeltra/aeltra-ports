        </patches>

        <requires>
            <package name="autoconf"/>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="bison"/>
            <package name="libncurses-dev"/>
            <package name="texinfo"/>
            <package name="gettext"/>
            <package name="xz-utils"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="bash.xml"/>
