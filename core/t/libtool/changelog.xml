<?xml version="1.0" encoding="utf-8"?>
<changelog>
    <release version="2.6.2" revision="3aeltra1" upstream-version="2.6.2-3"
        maintainer="Tobias Koch" email="tobias.koch@gmail.com"
        date="2026-11-20 23:45:16+03:00">
        <changeset>
            <li>Upgrade to version 2.6.2-3 from Debian forky.</li>
            <li>
                Regenerate the whole build system, with the autoconf and
                automake the package is built with.
            </li>
            <li>
                Do not write the paths of grep and sed at build time into
                libtool and libtoolize, they are looked up when the scripts
                run.
            </li>
            <li>
                The script libtool needs nothing of the tools folder and has
                nothing of the folders of GCC in it. It knows gcc, cc, g++ and
                c++ by these names.
            </li>
        </changeset>
    </release>
