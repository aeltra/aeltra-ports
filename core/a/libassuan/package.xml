<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="libassuan" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>IPC library for the GnuPG components</summary>
            <p>
            Libassuan is a small library implementing the so-called "Assuan
            protocol". This protocol is used for IPC between most newer GnuPG
            components. Both server and client side functions are provided.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="libassuan-3.0.2.tar.bz2" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/liba/libassuan/libassuan_3.0.2.orig.tar.bz2"
                sha256sum="d2931cdad266e633510f9970e1a2f346055e351bb19f9b78912475b8074c36f6"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="09261a66d8d1d11bb9efb1e48872ca1c24db9334d151dc444c9f1e31a15afbb8"/>
        </sources>

        <!-- Debian's patches are not applied. The first one is for
             Windows, the second one is for its own packaging and needs
             configure to be made again. See the comment in rules.xml. -->
        <!--
        <patches>
            <patchset subdir="sources">
                <file src="patches/0001-avoid-linker-errors-when-cross-building-for-win32.patch"/>
                <file src="patches/0002-avoid-self-describing-as-a-beta.patch"/>
            </patchset>
        </patches>
        -->

        <requires>
            <package name="libgpg-error-dev" version=">= 1.33"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libassuan9.xml"/>
    <xi:include href="libassuan-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
