<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="autoconf2.69" repo="core" architecture-independent="true" if="tools-build or target-build">
        <description>
            <summary>Automatic configure script builder (obsolete version)</summary>
            <p>
            This obsolete version is required to build GCC (&gt;= 8), newlib,
            and probably some other toolchain related packages.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="autoconf2.69-2.69.tar.xz" subdir="sources"
                sha256sum="64ebcec9f8ac5b2487125a86a7760d2591ac9e1d3dbd59489633f9de62a57684"/>
            <file src="debian-patches-5.tar.gz" subdir="patches"
                sha256sum="4752d166120b94c00579075929fe1bef741812fb936c6f2d3425d4f6307254f1"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/atomic.patch"/>
                <file src="patches/stricter-versioning.patch"/>
                <file src="patches/texinfo.patch"/>
                <file src="patches/AM_PROG_LIBTOOL.patch"/>
                <file src="patches/unescaped-left-brace-warning-fix.patch"/>
                <file src="patches/mmap-leak-fix.patch"/>
                <file src="patches/0001-doc-port-to-Texinfo-6.3.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="perl"/>
            <package name="m4"/>
            <package name="help2man"/>
            <package name="texinfo"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="autoconf2.69.xml"/>

    <xi:include href="changelog.xml"/>
</control>
