<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="attr" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Filesystem extended attributes modification</summary>
            <p>
            Tools and programming interfaces for modifying extended attributes
            on filesystems that support them.
            </p>
            <p>
            Currently only ext2, ext3, JFS and XFS support extended attributes.
            The SGI IRIX compatibility API built above the Linux system calls is
            used by programs such as xfsdump(8), xfsrestore(8) and xfs_fsr(8).
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="attr-2.6.0.tar.xz" subdir="sources"
                sha256sum="6c8a2148a7b85043b68492bce43316b0e2e214fc4e628c7ede078e76e216330b"/>
            <file src="debian-patches-1.tar.gz" subdir="patches"
                sha256sum="448b0ad24a48942683600b763b2ae1e3cea7da3d81156b8d0e142d9b1f6221e3"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/local/0001-po-Update-Dutch-translation.patch"/>
                <file src="patches/local/0002-build-Fix-cross-compilation-on-musl-based-systems.patch"/>
                <file src="patches/local/0003-man-Fix-formatting-markup-for-attr-1.patch"/>
                <file src="patches/local/0004-man-Clarify-attr-1-manual-page.patch"/>
                <file src="patches/local/0005-man-Mention-the-origins-of-ENOATTR.patch"/>
                <file src="patches/local/0006-man-Improve-markup-and-editorial-changes-for-setfatt.patch"/>
                <file src="patches/local/0007-man-Use-f-letter-instead-of-f-number-to-select-fonts.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="gettext"/>
            <package name="libtool"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="attr.xml"/>
    <xi:include href="libattr1-dev.xml"/>
    <xi:include href="libattr1.xml"/>

    <xi:include href="changelog.xml"/>
</control>
