<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="autoconf" repo="core" architecture-independent="true" if="tools-build or target-build">
        <description>
            <summary>Automatic configure script builder</summary>
            <p>
            The standard for FSF source packages. This is only useful if you
            write your own programs or if you extensively modify other people's 
            programs.
            </p>
            <p>
            This version of autoconf is not compatible with scripts meant for
            Autoconf 2.13 or earlier.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="autoconf-2.73.tar.xz" subdir="sources"
                sha256sum="9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="8bd773ccbfbf5139cad2a6fb796a7034711900599347b96e406a2ab154579576"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/0003-fix-false-positives-cpp-style-comments.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="perl"/>
            <package name="m4"/>
            <package name="texinfo"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="autoconf.xml"/>

    <xi:include href="changelog.xml"/>
</control>
