<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="audit" repo="core" architecture-independent="false"
            if="tools-build or target-build">
        <description>
            <summary>User space tools and libraries for security auditing</summary>
            <p>
            The audit package contains the user space utilities and libraries for
            storing and searching the audit records generated by the audit subsystem
            in the Linux 2.6 kernel.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="audit-4.1.2.tar.gz" subdir="sources"
                sha256sum="5c638bbeef9adb6c5715d3a60f0f5adb93e9b81633608af13d23c61f5e5db04d"/>
            <file src="debian-patches-1.tar.gz" subdir="patches"
                sha256sum="468dac5b2e4892ba00936d92a4fa5dc4aedc7bbb12d84d8f0c286661e26a3a3e"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <!-- Debian -->
                <file src="patches/01-no-refusemanualstop.patch"/>
                <file src="patches/03-Set-log_group-adm.patch"/>
                <file src="patches/debian-tmpfiles.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="libcap-ng-dev"/>
            <package name="linux-system-headers"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="auditd.xml"/>
    <xi:include href="libauparse0.xml"/>
    <xi:include href="libauparse-dev.xml"/>
    <xi:include href="libaudit1.xml"/>
    <xi:include href="libaudit-common.xml"/>
    <xi:include href="libaudit-dev.xml"/>
    <xi:include href="audispd-plugins.xml"/>
    <xi:include href="libauplugin1.xml"/>
    <xi:include href="libauplugin-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
