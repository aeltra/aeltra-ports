<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="acl" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Access control list management</summary>
            <p>
            Tools and programming interfaces for manipulating access control
            lists (ACL) on filesystems that support them.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="acl-2.4.0.tar.xz" subdir="sources"
                sha256sum="e661131456d2708a01c614a0f400e11d7d1bfaeb6f3e74b75bb980b72f0161a3"/>
            <file src="debian-patches-1.tar.gz" subdir="patches"
                sha256sum="aa125493a3a51e98e68482d756e3872e2c3061285a7a40c3e21a50c7bc7c8e0e"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/local/0001-build-Use-LDLIBS-instead-of-LDFLAGS-for-example-Make.patch"/>
                <file src="patches/local/0002-Fix-usage-of-uninitialized-variable.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="gettext"/>
            <package name="libtool"/>
            <package name="libattr1-dev"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="acl.xml"/>
    <xi:include href="libacl1-dev.xml"/>
    <xi:include href="libacl1.xml"/>

    <xi:include href="changelog.xml"/>
</control>
