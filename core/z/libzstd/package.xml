<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="libzstd" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Fast lossless compression algorithm</summary>
            <p>
            Zstd, short for Zstandard, is a fast lossless compression algorithm, targeting
            real-time compression scenarios at zlib-level compression ratio.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file 
                subdir="sources"
                src="libzstd-1.5.7+dfsg.tar.xz"
                upstream-src="http://ftp.debian.org/debian/pool/main/libz/libzstd/libzstd_1.5.7+dfsg.orig.tar.xz"
                sha256sum="0c092ef267edce57ba7f3f2645c861f72eaf5e76273c6c3632869423464b90a5"
            />
            <file 
                subdir="patches"
                src="debian-patches-4.tar.gz"
                upstream-src=""
                sha256sum="d7bece54ded9056736fcfa03122107017572750bfe9d98c80d118f1d8483c050"
            />
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/0006-Use-bash-for-test-script-portablitity.patch"/>
                <file src="patches/0008-Address-embedded-zlib.patch"/>
                <file src="patches/0013-skip-memory-greedy-tests.patch"/>
                <file src="patches/0014-Reproducible-build.patch"/>
                <file src="patches/0015-Skip-dev-random-tests-on-hurd.patch"/>
                <file src="patches/0017-alpha-fbfs-st_mtime.patch"/>
                <file src="patches/0018-kfreebsd-ftbfs-utime-now.patch"/>
                <file src="patches/0022-tests-timeout.patch"/>
                <file src="patches/0023-cmake-min-3.13.patch"/>
                <file src="patches/0024-no-lessopen-test.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="cmake"/>
            <package name="liblz4-dev"/>
            <package name="liblzma-dev"/>
            <package name="zlib1g-dev"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libzstd-dev.xml"/>
    <xi:include href="libzstd1.xml"/>
    <xi:include href="zstd.xml"/>

    <xi:include href="changelog.xml"/>
</control>
