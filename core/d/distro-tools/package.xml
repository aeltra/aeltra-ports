<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="distro-tools" repo="core" architecture-independent="true" if="tools-build or target-build">
        <description>
            <summary>Aeltra OS distro tools</summary>
            <p>
                The distro tools are a collection of programs for building and
                publishing Aeltra packages, such as aeltra-distro-info,
                aeltra-pack, aeltra-repo-index and aeltra-image.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file
                subdir="sources"
                src="distro-tools-1.20.0.tar.gz"
                upstream-src="https://github.com/aeltra/distro-tools/archive/refs/tags/1.20.0.tar.gz"
                sha256sum="f7a149ce9291836187cdd6a6560baa13844b54afb6e94d97cefb7912932fbc6f"/>
        </sources>

        <requires>
            <package name="python3-all"/>
            <package name="python3-installer"/>
            <package name="python3-setuptools" version=">= 61"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="aeltra-distro-info.xml"/>
    <xi:include href="aeltra-image.xml"/>
    <xi:include href="aeltra-package.xml"/>
    <xi:include href="aeltra-repo-index.xml"/>
    <xi:include href="python3-aeltra-distro-info.xml"/>
    <xi:include href="python3-aeltra-ffi-libarchive.xml"/>
    <xi:include href="python3-aeltra-image-gen.xml"/>
    <xi:include href="python3-aeltra-misc.xml"/>
    <xi:include href="python3-aeltra-package.xml"/>
    <xi:include href="python3-aeltra-repository.xml"/>

    <xi:include href="changelog.xml"/>
</control>
