<?xml version="1.0" encoding="utf-8"?>
<package name="python3-aeltra-package" section="devel">
    <description>
        <summary>Aeltra OS packaging tools</summary>
        <p>
        This package contains the aeltra-pack and deb2aeltra tools.
        </p>
    </description>

    <requires>
        <package name="autotools-dev" tools-prefix=""/>
        <package name="binutils" tools-prefix="tools-target-"/>
        <package name="binutils" tools-prefix="tools-"/>
        <package name="chrpath"/>
        <package name="gnupg"/>
        <package name="patch"/>
        <package name="python3"/>
        <package name="python3-aeltra-ffi-libarchive"/>
        <package name="python3-aeltra-misc"/>
        <package name="python3-aeltra-distro-info"/>
        <package name="python3-dateutil"/>
        <package name="python3-html2text"/>
        <package name="python3-lxml"/>
        <package name="python3-magic"/>
        <package name="usign"/>
    </requires>

    <contents subdir="package">
        <file src="/"/>
    </contents>
</package>
