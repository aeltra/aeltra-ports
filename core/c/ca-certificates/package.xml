<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="ca-certificates" repo="core" architecture-independent="true" if="target-build">
        <description>
            <summary>Common CA certificates</summary>
            <p>
            Contains the certificate authorities shipped with Mozilla's browser to allow
            SSL-based applications to check for the authenticity of SSL connections.
            </p>
            <p>
            Please note that the distributor can neither confirm nor deny whether the
            certificate authorities whose certificates are included in this package
            have in any way been audited for trustworthiness or RFC 3647 compliance.
            Full responsibility to assess them belongs to the local system
            administrator.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="ca-certificates-20260816+nmu1.tar.xz" subdir="sources"
                sha256sum="914416a1e44a25733aff51092fe4e27fdec1c9f6e8d1db0b8364922486153134"/>
            <file src="aeltra-patches-1.tar.gz" subdir="patches"
                sha256sum="2981bb8bd6710f3e49831566ba0c692479797e30480473357101ea0b0afa35a9"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <!-- The module is only used to warn about expired
                     certificates. It needs Rust to build. -->
                <file src="patches/certdata2pem-without-cryptography.diff"/>
                <file src="patches/root-only-restorecon.diff"/>
            </patchset>
        </patches>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="ca-certificates.xml"/>

    <xi:include href="changelog.xml"/>
</control>
