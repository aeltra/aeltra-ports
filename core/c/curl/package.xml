<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="curl" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Easy-to-use client-side URL transfer library</summary>
            <p>
            libcurl is an easy-to-use client-side URL transfer library, supporting DICT,
            FILE, FTP, FTPS, GOPHER, HTTP, HTTPS, IMAP, IMAPS, LDAP, LDAPS, POP3, POP3S,
            RTMP, RTSP, SCP, SFTP, SMTP, SMTPS, TELNET and TFTP.
            </p>
            <p>
            libcurl supports SSL certificates, HTTP POST, HTTP PUT, FTP uploading, HTTP
            form based upload, proxies, cookies, user+password authentication (Basic,
            Digest, NTLM, Negotiate, Kerberos), file transfer resume, http proxy tunneling
            and more!
            </p>
            <p>
            libcurl is free, thread-safe, IPv6 compatible, feature rich, well supported,
            fast, thoroughly documented and is already used by many known, big and
            successful companies and numerous applications.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="curl-8.23.0.tar.gz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/c/curl/curl_8.23.0.orig.tar.gz"
                sha256sum="e3de77cfa6367083c776a26647fc9f633b538c06c3baa73d931a252ac8f72b49"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="a3b7a757bfbb27db814e2d74861d4de58e552097658ac5f50323e12cdcc6d548"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/ZZZgnutls-build.patch"/>
                <file src="patches/build-Divide-mit-krb5-gssapi-link-flags-between-LDFLAGS-a.patch"/>
                <file src="patches/11_omit-directories-from-config.patch"/>
                <file src="patches/Implement-symbol-versioning-for-CURL_GNUTLS_3.patch"/>
                <file src="patches/disable-strictmodes-in-test-sshd.patch"/>
                <file src="patches/pytest-timeline-check-time_queue.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="autotools-dev" tools-prefix=""/>
            <package name="libbrotli-dev"/>
            <package name="libgnutls28-dev"/>
            <package name="libidn2-dev"/>
            <package name="libnghttp2-dev"/>
            <package name="libpsl-dev"/>
            <package name="libssl-dev"/>
            <package name="libtool"/>
            <package name="libzstd-dev"/>
            <package name="nettle-dev"/>
            <package name="perl"/>
            <package name="pkg-config"/>
            <package name="zlib1g-dev"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="curl.xml"/>
    <xi:include href="libcurl4.xml"/>
    <xi:include href="libcurl4-gnutls.xml"/>
    <xi:include href="libcurl4-openssl-dev.xml"/>
    <xi:include href="libcurl4-gnutls-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
