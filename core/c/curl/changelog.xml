<changelog>
    <release version="8.23.0" revision="2aeltra1" upstream-version="8.23.0-2"
        maintainer="Tobias Koch" email="tobias.koch@gmail.com"
        date="2026-11-24 15:14:08+03:00">
        <changeset>
            <li>New upstream version, the one of Debian Forky, with
            Debian's patches</li>
            <li>Built against OpenSSL and GnuTLS. The variant for NSS is
            gone, upstream no longer supports it</li>
            <li>libcurl4 and libcurl4-gnutls take the place of libcurl3 and
            libcurl3-gnutls, without the links for version 3</li>
            <li>With nghttp2, libidn2, libpsl, brotli and zstd</li>
        </changeset>
    </release>
