<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
sed -i "s@/usr/include@$AELTRA_INSTALL_PREFIX/include@g" Make.Rules

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make \
    CC="${AELTRA_HOST_TYPE}-gcc" \
    AR="${AELTRA_HOST_TYPE}-ar" \
    RANLIB="${AELTRA_HOST_TYPE}-ranlib" \
    -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" prefix="$AELTRA_INSTALL_PREFIX" lib=lib install 

    ]]>
    </install>
</rules>
