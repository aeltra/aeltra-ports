<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
autoreconf -vif

cd "$AELTRA_BUILD_DIR"
$AELTRA_SOURCE_DIR/configure \
    --enable-relocatable \
    --enable-shared \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE"

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
