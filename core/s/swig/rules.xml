<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

export PCRE_CONFIG="$AELTRA_INSTALL_PREFIX/bin/pcre-config"

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --without-alllang \
    --with-swiglibdir="$AELTRA_INSTALL_PREFIX/share/swig4.0" \
    --program-suffix=4.0

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
