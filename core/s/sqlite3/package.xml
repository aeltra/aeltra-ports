<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="sqlite3" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>SQLite 3 database engine</summary>
            <p>
            SQLite is a C library that implements an SQL database engine. 
            Programs that link with the SQLite library can have SQL database 
            access without running a separate RDBMS process.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="sqlite3-3.54.1.tar.xz" subdir="sources"
                sha256sum="faeff7682200b3dd58c8f0f229892a7271c73c1fdabc86e7315eb31eb7cb6e83"/>
            <file src="sqlite3-www-3.54.1.tar.xz" subdir="sources/www"
                sha256sum="67906ee141109bebe43cdcf197892806397dabc79f5cd7f05f1278f47b0c5e25"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="4c894d5b9c9942198537cc7d952d9c07dd0c515912e704f41919c6aef78dfd5e"/>
            <file src="aeltra-patches-1.tar.gz" subdir="patches"
                sha256sum="f7df83efe5621c33c43b8feabac3827cb79275b4d6da1bc85d77b4829dcb8507"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/20-hurd-locking-style.patch"/>
                <file src="patches/31-increase_SQLITE_MAX_DEFAULT_PAGE_SIZE_to_32k.patch"/>
                <file src="patches/02-use-packaged-lempar.c.patch"/>
                <file src="patches/cross.patch"/>
                <file src="patches/dynamic-tcl-library.patch"/>
                <!-- Aeltra -->
                <file src="patches/lemon-template.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="libreadline-dev"/>
            <package name="zlib1g-dev"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="lemon.xml"/>
    <xi:include href="sqlite3.xml"/>
    <xi:include href="libsqlite3-0.xml"/>
    <xi:include href="libsqlite3-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
