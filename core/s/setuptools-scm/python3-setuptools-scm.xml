<?xml version="1.0" encoding="utf-8"?>
<package name="python3-setuptools-scm" section="python">
    <description>
        <summary>Manage the versions of Python packages by SCM tags</summary>
        <p>
        setuptools-scm handles managing your Python package versions in SCM metadata.
        It also handles file finders for the supported SCMs.
        </p>
    </description>

    <requires>
        <package name="python3"/>
        <package name="python3-packaging"/>
        <package name="python3-setuptools"/>
    </requires>

    <contents subdir="python3" collect-py-cache-files="true">
        <file src="${prefix}/bin/setuptools-scm"/>
        <file src="${prefix}/lib/python3/dist-packages"/>
    </contents>
</package>
