<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="sources"/>
    </defines>

    <source name="setuptools-scm" repo="core" architecture-independent="true" if="tools-build or target-build">
        <description>
            <summary>Manage the versions of Python packages by SCM tags</summary>
            <p>
            setuptools-scm handles managing your Python package versions in SCM metadata.
            It also handles file finders for the supported SCMs.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="setuptools-scm-9.2.2.tar.gz" subdir="sources"
                sha256sum="853f06f1ab2cebd2bef6970c76fdf6bd6bad250c69b9d966d5a3e14f9d503df1"/>
            <file src="debian-patches-2.tar.gz" subdir="patches"
                sha256sum="5e4274c9a7f58b5a47da3667c2977ce5ef0e0cdc1483d25c3f9c1358eed773bd"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/tests-ignore-SETUPTOOLS_SCM_PRETEND_VERSION"/>
                <file src="patches/accept_debian_tags.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="python3"/>
            <package name="python3-installer"/>
            <package name="python3-packaging"/>
            <package name="python3-setuptools"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="python3-setuptools-scm.xml"/>

    <xi:include href="changelog.xml"/>
</control>
