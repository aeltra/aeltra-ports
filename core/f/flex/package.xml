<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="flex" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Fast lexical analyzer generator</summary>
            <p>
            Flex is a tool for generating scanners: programs which recognized lexical
            patterns in text. It reads the given input files for a description of a
            scanner to generate. The description is in the form of pairs of regular
            expressions and C code, called rules. Flex generates as output a C source
            file, lex.yy.c, which defines a routine yylex(). This file is compiled
            and linked with the -lfl library to produce an executable. When the
            executable is run, it analyzes its input for occurrences of the regular
            expressions. Whenever it finds one, it executes the corresponding C code.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="flex-2.6.4.tar.gz" subdir="sources"
                sha256sum="e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995"/>
            <file src="flex-2.6.4-8.2.debdiff.gz" subdir="patches"
                sha256sum="c2ee0c631289f8a4f945a4c62ac05b7fe4abee9c72be1ab5604b9cc44a3d8678"/>
            <file src="aeltra-patches-1.tar.gz" subdir="patches"
                sha256sum="3710363eb94f94fac1d2f3998d1f969ff8d348cab085b07baa87da22f7de1e3b"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <!-- Debian -->
                <file src="patches/flex-2.6.4-8.2.debdiff"/>
                <!-- Upstream -->
                <file src="patches/rpl-malloc-realloc-decl.diff"/>
                <!-- Aeltra -->
                <file src="patches/malloc-declaration-c23.diff"/>
            </patchset>
        </patches>

        <requires>
            <package name="autopoint"/>
            <package name="bison"/>
            <package name="flex"/>
            <package name="gettext"/>
            <package name="texinfo"/>
            <package name="help2man"/>
            <package name="file"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="flex.xml"/>
    <xi:include href="libfl-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
