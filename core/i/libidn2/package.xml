<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="libidn2" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Internationalized domain names (IDNA2008/TR46) library</summary>
            <p>
            Libidn2 implements the revised algorithm for internationalized domain
            names called IDNA2008/TR46.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <!-- Debian's sources are a snapshot of the repository. They have no
             configure script, see rules.xml. -->
        <sources>
            <file src="libidn2-2.3.8.tar.gz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/libi/libidn2/libidn2_2.3.8.orig.tar.gz"
                sha256sum="bbad1678d35d28e2c62e6a2577083829461402d9e47b908791c55314a5cb5e04"/>
            <file src="debian-patches-5.tar.gz" subdir="patches"
                sha256sum="29959bc96fa487ea97207aa3d8f1ce56991ff3be91b91fe75741c915b510e3e4"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/fix-blhc.patch"/>
            </patchset>
        </patches>

        <requires>
            <package name="autoconf"/>
            <package name="automake"/>
            <package name="autopoint"/>
            <package name="gengetopt"/>
            <package name="git"/>
            <package name="gnulib"/>
            <package name="gperf"/>
            <package name="help2man"/>
            <package name="libtool"/>
            <package name="libunistring-dev"/>
            <package name="pkg-config"/>
            <package name="texinfo"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="libidn2-0.xml"/>
    <xi:include href="libidn2-dev.xml"/>
    <xi:include href="idn2.xml"/>

    <xi:include href="changelog.xml"/>
</control>
