<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_BUILD_DIR/source"
./configure \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --enable-static

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR/source"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR/source"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
