<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
autoreconf -v -fi

cd "$AELTRA_BUILD_DIR"
$AELTRA_SOURCE_DIR/configure \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --enable-utf8 \
    --enable-unicode-properties \
    --enable-pcre16 \
    --enable-pcre32 \
    --disable-silent-rules \
    --build="$AELTRA_BUILD_TYPE" \
    --host="$AELTRA_HOST_TYPE"

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
