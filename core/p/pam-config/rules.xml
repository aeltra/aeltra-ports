<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
./autogen.sh

cd "$AELTRA_BUILD_DIR"
$AELTRA_SOURCE_DIR/configure \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_BUILD_TYPE" \
    --host="$AELTRA_HOST_TYPE"

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -C src -j"$AELTRA_PARALLEL_JOBS" pam-config

    ]]>
    </build>

    <install>
    <![CDATA[

install -d -m 0755 "$AELTRA_INSTALL_DIR/$AELTRA_INSTALL_PREFIX/sbin"
install -m 0755 "$AELTRA_BUILD_DIR/src/pam-config" \
    "$AELTRA_INSTALL_DIR/$AELTRA_INSTALL_PREFIX/sbin/"

    ]]>
    </install>
</rules>
