<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_SOURCE_DIR"
autoreconf -vfi

cd "$AELTRA_BUILD_DIR"
$AELTRA_SOURCE_DIR/configure \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_BUILD_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --sysconfdir=/etc \
    --libdir="$AELTRA_INSTALL_PREFIX/lib" \
    --bindir="$AELTRA_INSTALL_PREFIX/bin" \
    --sbindir="$AELTRA_INSTALL_PREFIX/sbin" \
    --disable-nls \
    --disable-cracklib \
    --disable-nis \
    --disable-rpath \
    --enable-shared \
    --enable-static \
    --enable-db=no \
    --includedir="$AELTRA_INSTALL_PREFIX/include/security"

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make CC="${AELTRA_TARGET_TYPE}-gcc" -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

install -d -m 0755 "$AELTRA_INSTALL_DIR/etc/pam.d"

install -m 644 "$AELTRA_WORK_DIR/extra/etc/pam.conf" \
    "$AELTRA_INSTALL_DIR/etc/"
install -m 644 "$AELTRA_WORK_DIR/extra/etc/pam.d/other" \
    "$AELTRA_INSTALL_DIR/etc/pam.d/"

cd "$AELTRA_INSTALL_DIR"

    ]]>
    </install>
</rules>
