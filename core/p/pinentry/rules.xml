<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --host="$AELTRA_HOST_TYPE" \
    --build="$AELTRA_HOST_TYPE" \
    --with-libassuan-prefix="$AELTRA_INSTALL_PREFIX" \
    --with-libgpg-error-prefix="$AELTRA_INSTALL_PREFIX" \
    --disable-pinentry-gtk2 \
    --disable-pinentry-gnome3 \
    --disable-libsecret \
    --disable-pinentry-qt5 \
    --disable-rpath \
    --enable-pinentry-tty \
    --enable-pinentry-curses

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

    ]]>
    </install>
</rules>
