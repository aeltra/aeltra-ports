<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="pinentry" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Curses-based PIN or pass-phrase entry dialog for GnuPG</summary>
            <p>
            This package contains a program that allows for secure entry of PINs or
            pass phrases. That means it tries to take care that the entered
            information is not swapped to disk or temporarily stored anywhere.
            This functionality is particularly useful for entering pass phrases
            when using encryption software such as GnuPG or e-mail clients using
            the same. It uses an open protocol and is therefore not tied to
            particular software.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="pinentry-1.3.3.tar.bz2" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/p/pinentry/pinentry_1.3.3.orig.tar.bz2"
                sha256sum="c2970f16d6afb66ecddfca767d743936c86239bff936eed7fd7597a678414b63"/>
            <file src="debian-patches-3.tar.gz" subdir="patches"
                sha256sum="0e37e0066cb0907af05d6f0bb965c04dabe0d5a3bf2fe3e8c7222c0990d7986c"/>
        </sources>

        <!-- Debian's patches are not applied. The first one is for its
             own packaging and needs configure to be made again, the
             others are for the GTK and GNOME programs, which are not
             built. See the comment in rules.xml. -->
        <!--
        <patches>
            <patchset subdir="sources">
                <file src="patches/0001-avoid-self-describing-as-a-beta.patch"/>
                <file src="patches/0002-gtk2-When-X11-input-grabbing-fails-try-again-over-0..patch"/>
                <file src="patches/0003-gnome3-Redirect-GLib-logging-messages-to-stderr.patch"/>
            </patchset>
        </patches>
        -->

        <requires>
            <package name="libassuan-dev"/>
            <package name="libgpg-error-dev"/>
            <package name="libncurses-dev"/>
            <package name="pkg-config"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="pinentry-curses.xml"/>
    <xi:include href="pinentry-tty.xml"/>

    <xi:include href="changelog.xml"/>
</control>
