<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <defines>
        <def name="AELTRA_BUILD_DIR" value="build"/>
    </defines>

    <source name="patch" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>Apply a diff file to an original</summary>
            <p>
            Patch will take a patch file containing any of the four forms
            of difference listing produced by the diff program and apply
            those differences to an original file, producing a patched
            version.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="patch-2.8.1.tar.xz" subdir="sources"
                sha256sum="3240c7959c5347c8ed347e3c4201c0337bf4240d5cf09d68889e58eeaba30e17"/>
            <file src="debian-patches-1.tar.gz" subdir="patches"
                sha256sum="a103c1854f038f18c7f2506845e23396273ffcc96bd1fbc1a4b81402fecf9ef7"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/m-merge"/>
            </patchset>
        </patches>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="patch.xml"/>

    <xi:include href="changelog.xml"/>
</control>
