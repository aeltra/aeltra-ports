<?xml version="1.0" encoding="utf-8"?>
<control xmlns:xi="http://www.w3.org/2001/XInclude">
    <source name="procps" repo="core" architecture-independent="false" if="tools-build or target-build">
        <description>
            <summary>/proc file system utilities</summary>
            <p>
            This package provides command line and full screen utilities for browsing
            procfs, a "pseudo" file system dynamically generated by the kernel to
            provide information about the status of entries in its process table
            (such as whether the process is running, stopped, or a "zombie").
            </p>
            <p>
            It contains free, kill, pkill, pgrep, pmap, ps, pwdx, skill, slabtop,
            snice, sysctl, tload, top, uptime, vmstat, w, and watch.
            </p>
        </description>

        <xi:include href="copyright.xml"/>

        <sources>
            <file src="procps-4.0.7.tar.xz" subdir="sources"
                upstream-src="http://ftp.debian.org/debian/pool/main/p/procps/procps_4.0.7.orig.tar.xz"
                sha256sum="36dd88bb129cbaad5c5481cddde6dd16ab533e677cf99c424f0bb63f555f7e47"/>
            <file src="debian-patches-1.1.tar.gz" subdir="patches"
                sha256sum="cd374af7c47ff86d519dac861c89ffa77ec04f4a088b827fcee51ec5239360e7"/>
        </sources>

        <patches>
            <patchset subdir="sources">
                <file src="patches/remove_strtod_tests"/>
                <file src="patches/disable_sched_test"/>
                <file src="patches/uptime_test"/>
                <file src="patches/no-hugetlb"/>
                <file src="patches/no-boottime"/>
                <file src="patches/no-opath"/>
                <file src="patches/fix-pointer-check"/>
                <file src="patches/kill-pgrp-exit"/>
            </patchset>
        </patches>

        <requires>
            <package name="libncurses-dev"/>
            <package name="libselinux1-dev"/>
            <package name="pkg-config"/>
            <package name="skalibs-dev" if="musl"/>
            <package name="utmps-dev" if="musl"/>
        </requires>

        <xi:include href="rules.xml"/>
    </source>

    <xi:include href="procps.xml"/>
    <xi:include href="sysctl.xml"/>
    <xi:include href="libproc2-1.xml"/>
    <xi:include href="libproc2-dev.xml"/>

    <xi:include href="changelog.xml"/>
</control>
