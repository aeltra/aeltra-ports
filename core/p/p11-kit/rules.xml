<?xml version="1.0" encoding="utf-8"?>
<rules>
    <prepare>
    <![CDATA[

export PKG_CONFIG="${AELTRA_HOST_TYPE}-pkg-config"

cd "$AELTRA_SOURCE_DIR"
bh_autotools_dev_update
autoreconf -vfi

cd "$AELTRA_BUILD_DIR"
"$AELTRA_SOURCE_DIR/configure" \
    --prefix="$AELTRA_INSTALL_PREFIX" \
    --build="$AELTRA_HOST_TYPE" \
    --host="$AELTRA_HOST_TYPE" \
    --disable-silent-rules \
    --with-trust-paths=/etc/ssl/certs/ca-certificates.crt \
    --with-hash-impl=internal \
    --disable-nls \
    --disable-doc

    ]]>
    </prepare>

    <build>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make -j"$AELTRA_PARALLEL_JOBS"

    ]]>
    </build>

    <install>
    <![CDATA[

cd "$AELTRA_BUILD_DIR"
make DESTDIR="$AELTRA_INSTALL_DIR" install

cd "$AELTRA_INSTALL_DIR"
find . -name "*.la" -exec rm '{}' ';'

ln -sf "libp11-kit.so" \
    "$AELTRA_INSTALL_DIR/$AELTRA_INSTALL_PREFIX/lib/p11-kit-proxy.so"

    ]]>
    </install>
</rules>
